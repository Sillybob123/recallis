rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // The same gate as firestore.rules, repeated because Storage rules and
    // Firestore rules are separate programs and cannot share a function.
    // If the domain ever changes, it changes in both files — the access test
    // checks that they still agree.
    function verifiedSchool() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('(?i)^[^@]+@som[.]umaryland[.]edu$');
    }

    // Opaque account ids, not addresses. See firestore.rules for why these
    // are exempt from the verification check.
    function grandfathered() {
      return request.auth != null && request.auth.uid in [
        '9JDZJEF9YhNuxIBN3Vwtbu2oqut2',
        'kM4QC3YCrWfhg9SbMEN29X4Wlgu1'
      ];
    }

    function allowed() {
      return verifiedSchool() || grandfathered();
    }

    // Only the owning signed-in user can read or write their own images, and
    // only actual image files under 20MB are accepted on upload.
    //
    // allowed() is here as well as on the uid check. Without it an account
    // from outside the school — which Firebase will still create, and which
    // can read nothing in Firestore — could still use the bucket as 20MB-a-
    // time file hosting, on the project's bill.
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && allowed();
      allow write: if request.auth != null
        && request.auth.uid == uid
        && allowed()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Nothing lives outside users/{uid}/, and nothing should become readable
    // by being added there later without a rule of its own.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
