rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Recallis is open to one school for now. Firebase Authentication will
    // still create an account for any address — blocking that needs a paid
    // Identity Platform function — so this is where it actually counts: an
    // account outside the domain is refused every document, which makes the
    // app useless to it.
    //
    // The two ids below predate the restriction. They are opaque account
    // ids, not addresses, and exist so the accounts that built this don't
    // lock themselves out.
    function fromSchool() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('(?i).*@som[.]umaryland[.]edu');
    }

    function grandfathered() {
      return request.auth != null && request.auth.uid in [
        '9JDZJEF9YhNuxIBN3Vwtbu2oqut2',
        'kM4QC3YCrWfhg9SbMEN29X4Wlgu1'
      ];
    }

    function allowed() {
      return fromSchool() || grandfathered();
    }

    // The one account that can see how the site is doing. An id, not an
    // address — this file is public.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'kM4QC3YCrWfhg9SbMEN29X4Wlgu1';
    }

    // Every user's data lives under users/{uid}/... and only that user
    // (once signed in) may read or write it. Nobody else — including other
    // signed-in users — can see it.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && allowed();
    }

    // Email reminder settings sit at the top level so the scheduled sender
    // can list everyone with reminders due. It reads with a service account,
    // which bypasses these rules; signed-in users still only reach their own
    // document, and nobody can list the collection from a browser.
    match /emailReminders/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && allowed();
    }

    // One small record per account: who they are, when they joined, when
    // they were last here. It exists so the site's owner can tell whether
    // anybody is using it, and it is the only collection any account other
    // than its own can read — by exactly one id.
    match /signups/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && allowed()
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // Feedback is write-only from the app: you can post yours, and nobody —
    // including you — can read anyone's back. Only the scheduled sender,
    // which authenticates as a service account, ever reads this collection.
    match /feedback/{id} {
      allow create: if request.auth != null
        && allowed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if false;
    }
  }
}
